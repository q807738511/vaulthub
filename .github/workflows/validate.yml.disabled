name: Validate

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: '1.23.x'
          cache: false

      - name: Check shell scripts
        run: |
          sh -n scripts/install.sh
          sh -n scripts/upgrade.sh
          sh -n scripts/rollback.sh

      - name: Check Go services
        run: |
          cd manager
          go test ./...
          go vet ./...
          go build ./...
          cd ../media-go
          go test ./...
          go vet ./...
          go build ./...

      - name: Check legacy C sources
        run: |
          gcc -Wall -Wextra -Werror -fsyntax-only vaulthub-manager.c
          gcc -Wall -Wextra -Werror -pthread -fsyntax-only tests/fixtures/media-api_legacy.c

      - name: Check JavaScript syntax
        run: |
          for f in web/js/*.js; do
            node --check "$f"
          done
          # Any remaining inline scripts in index.html must also parse.
          python3 - <<'PY'
          import re
          from pathlib import Path
          html = Path('index.html').read_text(encoding='utf-8')
          scripts = re.findall(r'<script(?![^>]*src)[^>]*>(.*?)</script>', html, re.S)
          body = '\n;\n'.join(s for s in scripts if s.strip())
          Path('/tmp/vaulthub-inline.js').write_text(body, encoding='utf-8')
          PY
          if [ -s /tmp/vaulthub-inline.js ]; then node --check /tmp/vaulthub-inline.js; fi

      - name: Validate Compose model
        run: |
          cp .env.example .env
          docker compose config >/dev/null

      - name: Validate bundled Caddyfile
        run: |
          chmod +x ./caddy
          ./caddy validate --config Caddyfile --adapter caddyfile
