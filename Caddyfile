# 单入口：Cloudflare Tunnel 的所有主机名均指向 http://192.168.112.3:8088
:8088 {
	encode zstd gzip

	@health path /healthz
	handle @health {
		respond "ok" 200
	}

	# Go 管理服务 API。
	handle /api/health {
		reverse_proxy http://127.0.0.1:9099
	}
	handle /api/login {
		reverse_proxy http://127.0.0.1:9099
	}
	handle /api/logout {
		reverse_proxy http://127.0.0.1:9099
	}
	handle /api/system/runtime {
		reverse_proxy http://127.0.0.1:9099
	}
	handle /api/admin/* {
		reverse_proxy http://127.0.0.1:9099
	}

	# VaultHub 内置系统监控 API。
	handle /api/system/* {
		reverse_proxy http://127.0.0.1:9100 {
			flush_interval -1
		}
	}

	# Go 字幕服务：本地自动扫描及可插拔在线字幕源。
	handle /api/media/subtitles/search {
		reverse_proxy http://127.0.0.1:9120
	}

	handle /api/media/subtitles/download {
		reverse_proxy http://127.0.0.1:9120
	}

	# 本地媒体库 API，仅由同容器内绑定回环地址的进程处理。
	handle /api/media/* {
		reverse_proxy http://127.0.0.1:9100 {
			flush_interval -1
		}
	}

	# WebUI 同源 API。handle_path 会剥掉 /api/glances 和 /api/mp 前缀。
	handle_path /api/glances/* {
		reverse_proxy http://{$NAS_IP:192.168.112.3}:61208
	}

	handle_path /api/mp/* {
		reverse_proxy http://{$NAS_IP:192.168.112.3}:3000 {
			# MoviePilot 部分无尾斜杠接口返回绝对 Location，改回同源代理路径。
			header_down Location ^https?://[^/]+(/.*)$ /api/mp$1
		}
	}

	# 媒体服务继续使用独立子域名，避免应用不支持 base path。
	@comic host comic.enged.top kom.enged.top
	handle @comic {
		reverse_proxy http://{$NAS_IP:192.168.112.3}:25600 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_down -X-Frame-Options
			header_down Content-Security-Policy "frame-ancestors {$DASHBOARD_ORIGIN:https://home.enged.top}"
		}
	}

	@kavita host kavita.enged.top
	handle @kavita {
		reverse_proxy http://{$NAS_IP:192.168.112.3}:8085 {
			header_down -X-Frame-Options
			header_down Content-Security-Policy "frame-ancestors {$DASHBOARD_ORIGIN:https://home.enged.top}"
		}
	}

	@book host book.enged.top
	handle @book {
		reverse_proxy http://{$NAS_IP:192.168.112.3}:8083 {
			header_down -X-Frame-Options
			header_down Content-Security-Policy "frame-ancestors {$DASHBOARD_ORIGIN:https://home.enged.top}"
		}
	}

	@plex host plex.enged.top
	handle @plex {
		reverse_proxy http://{$NAS_IP:192.168.112.3}:32400 {
			header_down -X-Frame-Options
			header_down Content-Security-Policy "frame-ancestors {$DASHBOARD_ORIGIN:https://home.enged.top}"
		}
	}

	@emby host emby.enged.top
	handle @emby {
		reverse_proxy http://{$NAS_IP:192.168.112.3}:8096 {
			header_down -X-Frame-Options
			header_down Content-Security-Policy "frame-ancestors {$DASHBOARD_ORIGIN:https://home.enged.top}"
		}
	}

	@jellyfin host jellyfin.enged.top
	handle @jellyfin {
