# VaultHub 固定环境变量
#
# 这里放「装好基本不用再动」的参数：容器内固定路径、官方 API 地址、
# 监控挂载点、缓存清理策略、硬件转码能力声明等。
# docker-compose.yml 通过 env_file 加载本文件，因此 compose 里只保留
# 你会经常调整的少数几项。
# 写法固定为 KEY=${KEY:-默认值}，一行一个：
#   · 直接改本文件的默认值即可生效；
#   · 也可以在同目录 .env 里写 KEY=值临时覆盖，无需改本文件。
# 不要写成 KEY: value（那是映射语法，compose 的 environment 列表会报
# unexpected type map[string]interface {}）。
#
# 改完后需要重建容器才会重新注入（restart 不够）：
#   docker compose up -d --force-recreate

# ---------- 基础时区 ----------
TZ=${TZ:-Asia/Shanghai}

# ---------- 内置 NAS 监控 ----------
SYSTEM_MONITOR_ENABLED=${SYSTEM_MONITOR_ENABLED:-true}
SYSTEM_MONITOR_PROC_ROOT=${SYSTEM_MONITOR_PROC_ROOT:-/host/proc}
SYSTEM_MONITOR_SYS_ROOT=${SYSTEM_MONITOR_SYS_ROOT:-/host/sys}
SYSTEM_MONITOR_INTERVAL=${SYSTEM_MONITOR_INTERVAL:-3}
SYSTEM_MONITOR_INTERFACE=${SYSTEM_MONITOR_INTERFACE:-}

# ---------- 容器内固定路径 ----------
MEDIA_ROOT=${MEDIA_ROOT:-/media}
MEDIA_RUNTIME_CONFIG=${MEDIA_RUNTIME_CONFIG:-/data/media-runtime.json}
# 阅读进度（漫画 / 电子书）服务端持久化文件，换浏览器或清缓存后进度不丢
MEDIA_READING_PROGRESS=${MEDIA_READING_PROGRESS:-/data/media-reading-progress.json}

# ---------- 媒体库扫描深度 ----------
# v0.9.30 起扫描会穿透符号链接目录（NAS 常把季目录/合集链接到别处），
# 这里限制递归层数以防病态链接结构；0 = 不限制。
MEDIA_SCAN_MAX_DEPTH=${MEDIA_SCAN_MAX_DEPTH:-32}

# ---------- TMDB / TVDB 与显式代理 ----------
TMDB_API_BASE=${TMDB_API_BASE:-https://api.themoviedb.org/3}
TMDB_IMAGE_BASE=${TMDB_IMAGE_BASE:-https://image.tmdb.org/t/p}
TVDB_API_KEY=${TVDB_API_KEY:-}
TVDB_API_BASE=${TVDB_API_BASE:-https://api4.thetvdb.com/v4}
# 例：http://192.168.112.3:7890；留空表示直连
SCRAPER_PROXY=${SCRAPER_PROXY:-}

# ---------- 转码缓存 ----------
MEDIA_CACHE_MAX_BYTES=${MEDIA_CACHE_MAX_BYTES:-30737418240}
MEDIA_CACHE_MAX_AGE_HOURS=${MEDIA_CACHE_MAX_AGE_HOURS:-168}
MEDIA_CACHE_CLEANUP_INTERVAL_HOURS=${MEDIA_CACHE_CLEANUP_INTERVAL_HOURS:-24}

# ---------- 在线字幕 ----------
SUBTITLE_SHOOTER_ENDPOINT=${SUBTITLE_SHOOTER_ENDPOINT:-}
SUBTITLE_ZIMUKU_BASE=${SUBTITLE_ZIMUKU_BASE:-}
SUBTITLE_SUBHD_BASE=${SUBTITLE_SUBHD_BASE:-}

# ---------- 硬件转码 ----------
# auto：优先 NVIDIA CUDA/NVENC，其次 VAAPI/QSV，最后回退 CPU。
FFMPEG_HWACCEL=${FFMPEG_HWACCEL:-auto}

# VAAPI/QSV 设备
VAAPI_DEVICE=${VAAPI_DEVICE:-/dev/dri/renderD128}

# NVIDIA 容器运行时
NVIDIA_VISIBLE_DEVICES=${NVIDIA_VISIBLE_DEVICES:-all}
NVIDIA_DRIVER_CAPABILITIES=${NVIDIA_DRIVER_CAPABILITIES:-compute,video,utility}
