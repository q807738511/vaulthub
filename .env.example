# VaultHub runtime configuration
# Copy this file to .env and edit for your environment.

WEBUI_PORT=8088
NAS_IP=192.168.112.3
DASHBOARD_ORIGIN=https://home.example.com

# Set a long random value before exposing VaultHub publicly.

# 内置系统监控（与 docker-compose.yml 中的环境变量对应）
SYSTEM_MONITOR_ENABLED=true
SYSTEM_MONITOR_INTERVAL=5
SYSTEM_MONITOR_INTERFACE=
SYSTEM_MONITOR_FILESYSTEMS=vol1,vol2,vol3
SYSTEM_MONITOR_PROC_ROOT=/host/proc
SYSTEM_MONITOR_SYS_ROOT=/host/sys

# NAS 宿主机媒体目录示例；请按 Compose 中实际容器映射填写。
MUSIC_PATH=/vol1/media/music
COMIC_PATH=/vol1/media/comics
BOOK_PATH=/vol1/media/books

# 可选：影视本地媒体库 TMDB 刮削 API Key；留空则默认豆瓣刮削，失败以文件名展示。
TMDB_API_KEY=
TMDB_API_BASE=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
MEDIA_SCRAPER_MODE=auto
MEDIA_RUNTIME_CONFIG=/data/media-runtime.json
MEDIA_CACHE_DIR=/data/transcode-cache
MEDIA_CACHE_MAX_BYTES=10737418240
MEDIA_CACHE_MAX_AGE_HOURS=168
MEDIA_CACHE_CLEANUP_INTERVAL_HOURS=24
