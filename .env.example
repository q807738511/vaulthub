# VaultHub runtime configuration
# Copy this file to .env and edit for your environment.

WEBUI_PORT=8088
NAS_IP=192.168.112.3
DASHBOARD_ORIGIN=https://home.example.com

# Set a long random value before exposing VaultHub publicly.
# The same token is required by the WebUI Caddy configuration dialog.
ADMIN_TOKEN=change-me-before-public-use
